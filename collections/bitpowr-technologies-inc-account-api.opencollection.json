              },
              {
                "name": "subId",
                "value": "",
                "type": "path",
                "description": "The subId of the account you want to generate address for."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint creates sub-account addresses using the account `uid` and sub accounts `uid`"
        },
